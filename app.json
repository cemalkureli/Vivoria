{
  "expo": {
    "name": "Healthcare",
    "slug": "healthcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/os.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080b"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/os.png",
        "backgroundColor": "#07080b"
      },
      "package": "com.healthcare.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "USE_FULL_SCREEN_INTENT",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/os.png",
          "color": "#e8f44a",
          "sounds": ["./assets/alarm.mp3"],
          "mode": "production"
        }
      ]
    ],
    "ios": {}
  }
}
